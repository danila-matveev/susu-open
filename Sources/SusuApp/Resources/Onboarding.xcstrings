    "ob.how.macText": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognition runs on this Mac, with no account or keys. The editor and the agent use a local model if there is one."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание работает на этом маке, без аккаунта и ключей. Редактор и агент работают через локальную модель, если она есть."
          }
        }
      }
    },
