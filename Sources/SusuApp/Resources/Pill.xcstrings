    },
    "toast.cloudLimitWords.text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он обновится в понедельник."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It resets on Monday."
          }
