    "toast.secureInput": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас диктовка недоступна"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation isn't available here"
          }
        }
      }
    },
    "toast.micSilent.title": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не получилось записать"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't record"
          }
        }
      }
    },
    "toast.micSilent.text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон не дал звука, ничего не сохранено."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone gave no sound. Nothing was saved."
          }
        }
      }
    },
    "toast.noNetwork": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сети. Звук сохранён — можно повторить в истории"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. The audio is saved, so you can retry it from History"
          }
        }
      }
    },
    "toast.noKey": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен ключ %@, чтобы диктовать"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation needs a %@ key"
          }
        }
      }
    },
    "toast.keyInvalid": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ не подошёл — проверь его в настройках"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key was rejected. Check it in Settings"
          }
        }
      }
    },
