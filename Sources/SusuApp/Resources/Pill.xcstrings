{
  "sourceLanguage": "ru",
  "version": "1.0",
  "strings": {
    "pill.hint": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми %@, чтобы закончить"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press %@ to finish"
          }
        }
      }
    },
    "pill.hint.note": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметка · нажми ⌘, чтобы закончить"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note · press ⌘ to finish"
          }
        }
      }
    },
