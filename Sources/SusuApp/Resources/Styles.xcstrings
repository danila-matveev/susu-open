    "st.level.careful": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Polished"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккуратная"
          }
        }
      }
    },
    "st.level.d.careful": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Polished like a letter: repeats and filler words go, phrasing is smoothed. Same meaning. The model gets 1.5 s."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как для письма: убираю повторы и слова-паразиты, сглаживаю фразы. Смысл тот же. Модель получает 1,5 с."
          }
        }
      }
    },
    "st.level.d.names": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only names and terms are fixed using your dictionary. Nothing else is touched. The model gets 0.35 s."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правлю только названия и термины по словарю. Больше ничего не трогаю. Модель получает 0,35 с."
          }
        }
      }
    },
    "st.level.d.normal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Punctuation and paragraphs are added and names fixed. Meaning and wording stay yours. The model gets 1.5 s."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расставляю знаки и абзацы, правлю названия. Смысл и слова остаются твоими. Модель получает 1,5 с."
          }
        }
      }
    },
    "st.level.d.verbatim": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text exactly as spoken. Only fillers like “um” and repeats are removed. Dictionary and snippets still work."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст как сказано. Убираю только «э», «мм» и повторы. Словарь и сниппеты работают."
          }
        }
      }
    },
