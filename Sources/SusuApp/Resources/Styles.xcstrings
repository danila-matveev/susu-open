    "st.del.d": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This style's apps move to the default style."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программы этого стиля перейдут в основной стиль."
          }
        }
      }
    },
    "st.del.fallback": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default style cannot be deleted: it catches whatever the others did not match. Make another style the default first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной стиль нельзя удалить: он ловит всё, что не подошло другим. Сначала сделай основным другой."
          }
        }
      }
    },
    "st.del.q": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the style “%@”? Its apps move to “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить стиль «%@»? Его программы перейдут в «%@»."
