    "st.cmds.d": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say “send” or “press Enter” at the end and Susu presses Enter after pasting. Handy in chats."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажи «отправь» или «нажми Enter» в конце, и Susu нажмёт Enter после вставки. Удобно в чатах."
          }
        }
      }
    },
